project QEC_ADA is
   for Source_Dirs use ("src", "codes", "decode", "routing", "spectral", "invariants");
   for Main use ("qec_ada.adb", "qec_research.adb", "qec_scale.adb");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build/bin";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa");
   end Compiler;
end QEC_ADA;
